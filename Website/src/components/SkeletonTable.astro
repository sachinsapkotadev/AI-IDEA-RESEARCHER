---
/**
 * Skeleton loading placeholder for table rows.
 * Shows animated placeholder rows matching table layout.
 */
interface Props {
  rows?: number;
  columns?: number;
  class?: string;
}

const { rows = 5, columns = 4, class: className = '' } = Astro.props;
---

<div class:list={['animate-pulse', className]}>
  {Array.from({ length: rows }).map((_, i) => (
    <div class:list={[
      'flex items-center gap-4 border-b border-hairline-soft px-4 py-3',
      i === rows - 1 && 'border-b-0',
    ]}>
      {Array.from({ length: columns }).map((_, j) => (
        <div
          class:list={[
            'h-3 rounded bg-hairline-soft',
            j === 0 ? 'w-1/3' : j === columns - 1 ? 'w-16' : 'w-20',
          ]}
        ></div>
      ))}
    </div>
  ))}
</div>
