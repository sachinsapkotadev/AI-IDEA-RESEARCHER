---
interface Props {
  tier: string;
  price: string;
  period?: string;
  description: string;
  features: string[];
  highlighted?: boolean;
  ctaLabel?: string;
  ctaHref?: string;
  class?: string;
}

const {
  tier,
  price,
  period = '/month',
  description,
  features,
  highlighted = false,
  ctaLabel = 'Get Started',
  ctaHref = '/dashboard',
  class: className = '',
} = Astro.props;
---

<div class:list={[
  'flex flex-col rounded-lg border bg-canvas-elevated p-8',
  highlighted ? 'border-ink shadow-floating scale-[1.02]' : 'border-hairline',
  className,
]}>
  {highlighted && (
    <span class="mb-4 inline-block self-start rounded-full bg-ink px-3 py-1 text-xs font-medium text-on-primary">
      Most Popular
    </span>
  )}
  <h3 class="text-lg font-semibold text-ink">{tier}</h3>
  <p class="mt-2 text-sm text-body">{description}</p>
  <div class="mt-6 flex items-baseline gap-1">
    <span class="text-4xl font-semibold tracking-tight text-ink">{price}</span>
    {period && <span class="text-sm text-mute">{period}</span>}
  </div>
  <ul class="mt-8 flex flex-1 flex-col gap-3">
    {features.map((feature) => (
      <li class="flex items-start gap-3 text-sm text-body">
        <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path d="M5 13l4 4L19 7" />
        </svg>
        {feature}
      </li>
    ))}
  </ul>
  <a
    href={ctaHref}
    class:list={[
      'mt-8 inline-flex items-center justify-center rounded-sm px-4 py-2.5 text-sm font-medium no-underline transition-all',
      highlighted
        ? 'bg-primary text-on-primary hover:opacity-90'
        : 'border border-hairline bg-canvas-elevated text-ink hover:bg-hairline-soft',
    ]}
  >
    {ctaLabel}
  </a>
</div>
