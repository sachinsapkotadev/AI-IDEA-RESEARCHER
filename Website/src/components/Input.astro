---
interface Props {
  label?: string;
  name?: string;
  type?: string;
  placeholder?: string;
  required?: boolean;
  error?: string;
  class?: string;
  value?: string;
}

const { label, name, type = 'text', placeholder, required = false, error, class: className = '', value } = Astro.props;
---

<div class:list={['flex flex-col gap-1.5', className]}>
  {label && (
    <label for={name} class="text-sm font-medium text-ink">
      {label}
      {required && <span class="text-error">*</span>}
    </label>
  )}
  <input
    type={type}
    id={name}
    name={name}
    placeholder={placeholder}
    required={required}
    value={value}
    class:list={[
      'rounded-sm border bg-canvas-elevated px-3 py-2 text-sm text-ink placeholder-faint transition-colors',
      'focus:border-link focus:outline-none focus:ring-1 focus:ring-link',
      error ? 'border-error' : 'border-hairline',
    ]}
  />
  {error && <p class="text-xs text-error">{error}</p>}
</div>
