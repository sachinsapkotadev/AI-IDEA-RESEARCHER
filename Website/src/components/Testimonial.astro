---
interface Props {
  quote: string;
  author: string;
  role?: string;
  company?: string;
  class?: string;
}

const { quote, author, role, company, class: className = '' } = Astro.props;
---

<figure class:list={['rounded-md border border-hairline bg-canvas-elevated p-6', className]}>
  <div class="mb-3 flex gap-0.5">
    {[1, 2, 3, 4, 5].map(() => (
      <svg class="h-4 w-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
      </svg>
    ))}
  </div>
  <blockquote class="text-sm leading-relaxed text-body">"{quote}"</blockquote>
  <figcaption class="mt-4 flex items-center gap-3">
    <div class="flex h-8 w-8 items-center justify-center rounded-full bg-hairline-soft text-xs font-semibold text-ink">
      {author.charAt(0)}
    </div>
    <div>
      <p class="text-sm font-medium text-ink">{author}</p>
      {role && company && (
        <p class="text-xs text-mute">{role}, {company}</p>
      )}
    </div>
  </figcaption>
</figure>
