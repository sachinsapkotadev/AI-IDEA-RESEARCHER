---
interface Props {
  variant?: 'default' | 'success' | 'warning' | 'error' | 'info';
  class?: string;
}

const { variant = 'default', class: className = '' } = Astro.props;

const variants: Record<string, string> = {
  default: 'bg-hairline-soft text-body border-hairline',
  success: 'bg-success-soft text-green-800 border-green-200',
  warning: 'bg-warning-soft text-amber-800 border-amber-200',
  error: 'bg-red-50 text-red-800 border-red-200',
  info: 'bg-link-soft text-blue-800 border-blue-200',
};
---

<span class:list={[
  'inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-medium',
  variants[variant],
  className,
]}>
  <slot />
</span>
