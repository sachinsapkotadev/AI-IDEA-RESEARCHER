---
interface Props {
  title?: string;
  message: string;
  retryLabel?: string;
  class?: string;
}

const { title = 'Something went wrong', message, retryLabel, class: className = '' } = Astro.props;
---

<div class:list={['flex flex-col items-center justify-center py-16 text-center', className]}>
  <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-red-50 text-error">
    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path d="M12 9v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
  </div>
  <h3 class="text-lg font-semibold text-ink">{title}</h3>
  <p class="mt-2 max-w-sm text-sm text-body">{message}</p>
  {retryLabel && (
    <button
      onclick="window.location.reload()"
      class="mt-6 inline-flex items-center rounded-sm bg-primary px-4 py-2 text-sm font-medium text-on-primary transition-opacity hover:opacity-90"
    >
      {retryLabel}
    </button>
  )}
</div>
