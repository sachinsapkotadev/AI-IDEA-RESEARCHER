---
interface Props {
  title: string;
  description?: string;
  class?: string;
}

const { title, description, class: className = '' } = Astro.props;
---

<div class:list={['text-center', className]}>
  <h2 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl lg:text-4xl">{title}</h2>
  {description && (
    <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-body">{description}</p>
  )}
</div>
