---
interface Props {
  icon?: string;
  title: string;
  description: string;
  class?: string;
}

const { icon, title, description, class: className = '' } = Astro.props;
---

<div class:list={['rounded-md border border-hairline bg-canvas-elevated p-6', className]}>
  {icon && (
    <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-sm bg-hairline-soft text-ink">
      <Fragment set:html={icon} />
    </div>
  )}
  <h3 class="text-base font-semibold text-ink">{title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-body">{description}</p>
</div>
