---
import BaseHead from './BaseHead.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

interface SidebarLink {
  href: string;
  label: string;
  section: 'main' | 'system' | 'bottom';
}

const sidebarLinks: SidebarLink[] = [
  { href: '/dashboard', label: 'Dashboard', section: 'main' },
  { href: '/dashboard/research', label: 'Research', section: 'main' },
  { href: '/dashboard/chat', label: 'AI Chat', section: 'main' },
  { href: '/dashboard/ideas', label: 'Ideas', section: 'main' },
  { href: '/dashboard/agents', label: 'Agents', section: 'main' },
  { href: '/dashboard/reports', label: 'Reports', section: 'main' },
  { href: '/dashboard/status', label: 'Server Status', section: 'system' },
  { href: '/dashboard/models', label: 'Models', section: 'system' },
  { href: '/dashboard/github', label: 'GitHub', section: 'system' },
  { href: '/dashboard/automation', label: 'Automation', section: 'system' },
  { href: '/dashboard/settings', label: 'Settings', section: 'bottom' },
];

const mainLinks = sidebarLinks.filter(l => l.section === 'main');
const systemLinks = sidebarLinks.filter(l => l.section === 'system');
const bottomLinks = sidebarLinks.filter(l => l.section === 'bottom');

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/dashboard') return currentPath === '/dashboard' || currentPath === '/dashboard/';
  return currentPath.startsWith(href);
}
---

<BaseHead title={title} description={description}>
  {/* noindex for dashboard pages */}
  <meta name="robots" content="noindex, nofollow" />

  <div class="flex min-h-screen bg-canvas">
    {/* Sidebar — desktop */}
    <aside class="hidden w-60 flex-shrink-0 border-r border-hairline bg-canvas-elevated lg:flex lg:flex-col">
      {/* Logo */}
      <div class="flex h-14 items-center border-b border-hairline px-5">
        <a href="/" class="text-sm font-semibold text-ink no-underline" aria-label="AI Idea Researcher — Home">
          AI Idea Researcher
        </a>
      </div>

      {/* Navigation */}
      <nav class="flex-1 overflow-y-auto px-3 py-4" aria-label="Dashboard navigation">
        {/* Main section */}
        <ul class="flex flex-col gap-0.5" role="list">
          {mainLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  'flex items-center gap-3 rounded-sm px-3 py-2 text-sm no-underline transition-colors',
                  isActive(link.href)
                    ? 'bg-hairline-soft font-medium text-ink'
                    : 'text-body hover:bg-hairline-soft hover:text-ink',
                ]}
                aria-current={isActive(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>

        {/* System section */}
        <div class="mt-6">
          <p class="mb-1.5 px-3 text-[11px] font-medium uppercase tracking-wider text-faint">System</p>
          <ul class="flex flex-col gap-0.5" role="list">
            {systemLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class:list={[
                    'flex items-center gap-3 rounded-sm px-3 py-2 text-sm no-underline transition-colors',
                    isActive(link.href)
                      ? 'bg-hairline-soft font-medium text-ink'
                      : 'text-body hover:bg-hairline-soft hover:text-ink',
                  ]}
                  aria-current={isActive(link.href) ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </nav>

      {/* Bottom section — Settings + User */}
      <div class="border-t border-hairline px-3 py-3">
        <ul class="flex flex-col gap-0.5" role="list">
          {bottomLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  'flex items-center gap-3 rounded-sm px-3 py-2 text-sm no-underline transition-colors',
                  isActive(link.href)
                    ? 'bg-hairline-soft font-medium text-ink'
                    : 'text-body hover:bg-hairline-soft hover:text-ink',
                ]}
                aria-current={isActive(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-2 flex items-center gap-3 border-t border-hairline pt-3">
          <div class="flex h-8 w-8 items-center justify-center rounded-full bg-primary text-sm font-medium text-on-primary" aria-hidden="true">
            U
          </div>
          <div class="flex-1 truncate">
            <p class="truncate text-sm font-medium text-ink">User</p>
            <p class="truncate text-xs text-mute">Free Plan</p>
          </div>
          <ThemeToggle />
        </div>
      </div>
    </aside>

    {/* Main area */}
    <div class="flex flex-1 flex-col">
      {/* Mobile header */}
      <header class="flex h-14 items-center justify-between border-b border-hairline bg-canvas-elevated px-4 lg:hidden">
        <a href="/" class="text-sm font-semibold text-ink no-underline" aria-label="AI Idea Researcher — Home">
          AI Idea Researcher
        </a>
        <div class="flex items-center gap-2">
          <ThemeToggle />
          <button
            id="mobile-sidebar-toggle"
            class="flex items-center justify-center rounded-sm p-2 text-ink"
            aria-label="Open navigation menu"
            aria-expanded="false"
            aria-controls="mobile-sidebar"
          >
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </header>

      {/* Mobile sidebar overlay */}
      <div
        id="mobile-sidebar-overlay"
        class="fixed inset-0 z-40 hidden bg-black/40 lg:hidden"
        aria-hidden="true"
      ></div>

      {/* Mobile sidebar panel */}
      <aside
        id="mobile-sidebar"
        class="fixed inset-y-0 left-0 z-50 hidden w-64 bg-canvas-elevated shadow-lg lg:hidden"
        aria-label="Dashboard navigation"
        role="dialog"
        aria-modal="true"
      >
        <div class="flex h-14 items-center justify-between border-b border-hairline px-5">
          <a href="/" class="text-sm font-semibold text-ink no-underline">
            AI Idea Researcher
          </a>
          <button id="mobile-sidebar-close" class="rounded-sm p-1 text-ink" aria-label="Close navigation menu">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <nav class="overflow-y-auto px-3 py-4" aria-label="Dashboard navigation">
          {/* Main section */}
          <ul class="flex flex-col gap-0.5" role="list">
            {mainLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class:list={[
                    'flex items-center gap-3 rounded-sm px-3 py-2 text-sm no-underline transition-colors',
                    isActive(link.href)
                      ? 'bg-hairline-soft font-medium text-ink'
                      : 'text-body hover:bg-hairline-soft hover:text-ink',
                  ]}
                  aria-current={isActive(link.href) ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>

          {/* System section */}
          <div class="mt-6">
            <p class="mb-1.5 px-3 text-[11px] font-medium uppercase tracking-wider text-faint">System</p>
            <ul class="flex flex-col gap-0.5" role="list">
              {systemLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class:list={[
                      'flex items-center gap-3 rounded-sm px-3 py-2 text-sm no-underline transition-colors',
                      isActive(link.href)
                        ? 'bg-hairline-soft font-medium text-ink'
                        : 'text-body hover:bg-hairline-soft hover:text-ink',
                    ]}
                    aria-current={isActive(link.href) ? 'page' : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          {/* Bottom section */}
          <div class="mt-6 border-t border-hairline pt-4">
            <ul class="flex flex-col gap-0.5" role="list">
              {bottomLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class:list={[
                      'flex items-center gap-3 rounded-sm px-3 py-2 text-sm no-underline transition-colors',
                      isActive(link.href)
                        ? 'bg-hairline-soft font-medium text-ink'
                        : 'text-body hover:bg-hairline-soft hover:text-ink',
                    ]}
                    aria-current={isActive(link.href) ? 'page' : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </nav>
      </aside>

      {/* Page content */}
      <main class="flex-1 overflow-y-auto" id="main-content">
        <slot />
      </main>
    </div>
  </div>

  <script>
    const toggleBtn = document.getElementById('mobile-sidebar-toggle');
    const closeBtn = document.getElementById('mobile-sidebar-close');
    const overlay = document.getElementById('mobile-sidebar-overlay');
    const sidebar = document.getElementById('mobile-sidebar');

    function openSidebar() {
      overlay?.classList.remove('hidden');
      sidebar?.classList.remove('hidden');
      toggleBtn?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    }

    function closeSidebar() {
      overlay?.classList.add('hidden');
      sidebar?.classList.add('hidden');
      toggleBtn?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      toggleBtn?.focus();
    }

    toggleBtn?.addEventListener('click', openSidebar);
    closeBtn?.addEventListener('click', closeSidebar);
    overlay?.addEventListener('click', closeSidebar);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !sidebar?.classList.contains('hidden')) {
        closeSidebar();
      }
    });
  </script>

  <style is:global>
    .anim-fade-up {
      opacity: 0;
      transform: translateY(32px);
      transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .anim-fade-up.is-visible { opacity: 1; transform: translateY(0); }

    .anim-item {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
      transition-delay: calc(var(--i, 0) * 0.08s);
    }
    .anim-item.is-visible { opacity: 1; transform: translateY(0); }

    .anim-scale {
      opacity: 0;
      transform: scale(0.92);
      transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .anim-scale.is-visible { opacity: 1; transform: scale(1); }

    @media (prefers-reduced-motion: reduce) {
      .anim-fade-up, .anim-item, .anim-scale {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
    }
  </style>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const els = document.querySelectorAll('.anim-fade-up, .anim-item, .anim-scale');
      if (!els.length) return;
      const io = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.12 });
      els.forEach(el => io.observe(el));
    });
  </script>

</BaseHead>
