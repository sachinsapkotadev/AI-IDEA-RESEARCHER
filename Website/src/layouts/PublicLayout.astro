---
import BaseHead from './BaseHead.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description?: string;
  showHeader?: boolean;
  showFooter?: boolean;
}

const {
  title,
  description,
  showHeader = true,
  showFooter = true,
} = Astro.props;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/features', label: 'Features' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
];

const currentPath = Astro.url.pathname;
---

<BaseHead title={title} description={description}>
  {showHeader && (
    <header class="sticky top-0 z-50 border-b border-hairline bg-canvas/80 backdrop-blur-md">
      <nav class="container-page flex h-16 items-center justify-between">
        <a href="/" class="text-lg font-semibold text-ink no-underline">
          AI Idea Researcher
        </a>

        {/* Desktop nav */}
        <div class="hidden items-center gap-1 md:flex">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                'rounded-full px-3 py-1.5 text-sm text-body no-underline transition-colors hover:text-ink',
                currentPath.startsWith(link.href) && 'font-medium text-ink',
              ]}
            >
              {link.label}
            </a>
          ))}
        </div>

        <div class="hidden items-center gap-2 md:flex">
          <ThemeToggle />
          <a href="/dashboard" class="rounded-sm px-3 py-1.5 text-sm text-body no-underline transition-colors hover:text-ink">
            Log In
          </a>
          <a href="/dashboard" class="rounded-sm bg-primary px-3 py-1.5 text-sm font-medium text-on-primary no-underline transition-opacity hover:opacity-90">
            Get Started
          </a>
        </div>

        {/* Mobile menu button */}
        <button
          id="mobile-menu-toggle"
          class="flex items-center justify-center rounded-sm p-2 text-ink md:hidden"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path id="menu-icon-open" d="M4 6h16M4 12h16M4 18h16" />
            <path id="menu-icon-close" class="hidden" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </nav>

      {/* Mobile menu */}
      <div id="mobile-menu" class="hidden border-t border-hairline bg-canvas md:hidden">
        <div class="container-page flex flex-col gap-1 py-4">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                'rounded-sm px-3 py-2 text-sm text-body no-underline transition-colors hover:text-ink',
                currentPath.startsWith(link.href) && 'font-medium text-ink',
              ]}
            >
              {link.label}
            </a>
          ))}
          <hr class="my-2 border-hairline" />
          <a href="/dashboard" class="rounded-sm px-3 py-2 text-sm text-body no-underline">Log In</a>
          <a href="/dashboard" class="rounded-sm bg-primary px-3 py-2 text-center text-sm font-medium text-on-primary no-underline">Get Started</a>
        </div>
      </div>
    </header>
  )}

  <main>
    <slot />
  </main>

  {showFooter && (
    <footer class="border-t border-hairline bg-canvas">
      <div class="container-page section-padding">
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          <div>
            <a href="/" class="mb-4 text-lg font-semibold text-ink no-underline">
              AI Idea Researcher
            </a>
            <p class="mt-3 text-sm text-body">
              Turn daily research into actionable product ideas.
            </p>
          </div>
          <div>
            <h4 class="mb-3 text-sm font-semibold text-ink">Product</h4>
            <ul class="flex flex-col gap-2">
              <li><a href="/features" class="text-sm text-body no-underline transition-colors hover:text-ink">Features</a></li>
              <li><a href="/pricing" class="text-sm text-body no-underline transition-colors hover:text-ink">Pricing</a></li>
              <li><a href="/blog" class="text-sm text-body no-underline transition-colors hover:text-ink">Blog</a></li>
              <li><a href="/dashboard" class="text-sm text-body no-underline transition-colors hover:text-ink">Dashboard</a></li>
            </ul>
          </div>
          <div>
            <h4 class="mb-3 text-sm font-semibold text-ink">Company</h4>
            <ul class="flex flex-col gap-2">
              <li><a href="/about" class="text-sm text-body no-underline transition-colors hover:text-ink">About</a></li>
              <li><a href="/contact" class="text-sm text-body no-underline transition-colors hover:text-ink">Contact</a></li>
            </ul>
          </div>
          <div>
            <h4 class="mb-3 text-sm font-semibold text-ink">Legal</h4>
            <ul class="flex flex-col gap-2">
              <li><a href="#" class="text-sm text-body no-underline transition-colors hover:text-ink">Privacy Policy</a></li>
              <li><a href="#" class="text-sm text-body no-underline transition-colors hover:text-ink">Terms of Service</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-12 border-t border-hairline pt-8 text-center text-sm text-mute">
          &copy; {new Date().getFullYear()} AI Idea Researcher. All rights reserved.
        </div>
      </div>
    </footer>
  )}

  <script>
    const toggle = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    toggle?.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', (!expanded).toString());
      menu?.classList.toggle('hidden');
      iconOpen?.classList.toggle('hidden');
      iconClose?.classList.toggle('hidden');
    });
  </script>

  <style is:global>
    /* ============================================
       3D SCROLL ANIMATIONS — automatic, zero-class
       ============================================ */

    /* Base: perspective container on body */
    body { perspective: 1200px; }

    /* All sections get 3D entrance */
    main > section,
    main > article > section,
    article > section {
      opacity: 0;
      transform: perspective(1200px) rotateX(4deg) translateY(60px) scale(0.97);
      transform-origin: center bottom;
      transition:
        opacity 0.8s cubic-bezier(0.23, 1, 0.32, 1),
        transform 0.8s cubic-bezier(0.23, 1, 0.32, 1);
    }
    main > section.t3d-in,
    main > article > section.t3d-in,
    article > section.t3d-in {
      opacity: 1;
      transform: perspective(1200px) rotateX(0deg) translateY(0) scale(1);
    }

    /* Cards / bordered boxes — 3D tilt from left */
    .rounded-md.border,
    .rounded-lg.border,
    table {
      opacity: 0;
      transform: perspective(900px) rotateY(-6deg) translateX(-30px) scale(0.96);
      transform-origin: left center;
      transition:
        opacity 0.7s cubic-bezier(0.23, 1, 0.32, 1),
        transform 0.7s cubic-bezier(0.23, 1, 0.32, 1);
    }
    .rounded-md.border.t3d-in,
    .rounded-lg.border.t3d-in,
    table.t3d-in {
      opacity: 1;
      transform: perspective(900px) rotateY(0deg) translateX(0) scale(1);
    }

    /* Grid children — 3D pop with stagger */
    .grid > * {
      opacity: 0;
      transform: perspective(800px) rotateX(8deg) translateY(40px) scale(0.93);
      transform-origin: center bottom;
      transition:
        opacity 0.6s cubic-bezier(0.23, 1, 0.32, 1),
        transform 0.6s cubic-bezier(0.23, 1, 0.32, 1);
      transition-delay: calc(var(--ti, 0) * 0.1s);
    }
    .grid > *.t3d-in {
      opacity: 1;
      transform: perspective(800px) rotateX(0deg) translateY(0) scale(1);
    }

    /* Hero h1 — 3D cinematic entrance */
    h1 {
      opacity: 0;
      transform: perspective(1000px) rotateX(12deg) translateZ(-80px) scale(0.92);
      transform-origin: center center;
      transition:
        opacity 0.9s cubic-bezier(0.23, 1, 0.32, 1),
        transform 0.9s cubic-bezier(0.23, 1, 0.32, 1);
    }
    h1.t3d-in {
      opacity: 1;
      transform: perspective(1000px) rotateX(0deg) translateZ(0) scale(1);
    }

    /* Checkmark list items — 3D slide from depth */
    ul li {
      opacity: 0;
      transform: perspective(600px) translateZ(-40px) translateX(-20px) scale(0.95);
      transition:
        opacity 0.5s cubic-bezier(0.23, 1, 0.32, 1),
        transform 0.5s cubic-bezier(0.23, 1, 0.32, 1);
      transition-delay: calc(var(--ti, 0) * 0.07s);
    }
    ul li.t3d-in {
      opacity: 1;
      transform: perspective(600px) translateZ(0) translateX(0) scale(1);
    }

    /* Stat numbers — 3D counter pop */
    .text-3xl.font-semibold,
    .text-2xl.font-semibold {
      opacity: 0;
      transform: perspective(500px) rotateY(15deg) scale(0.8);
      transition:
        opacity 0.6s cubic-bezier(0.23, 1, 0.32, 1),
        transform 0.6s cubic-bezier(0.23, 1, 0.32, 1);
    }
    .text-3xl.font-semibold.t3d-in,
    .text-2xl.font-semibold.t3d-in {
      opacity: 1;
      transform: perspective(500px) rotateY(0deg) scale(1);
    }

    /* Badge / pill — 3D bounce in */
    .rounded-full.border,
    .rounded-full.bg-ink,
    .rounded-full.bg-primary {
      opacity: 0;
      transform: perspective(400px) rotateX(-20deg) scale(0.7);
      transition:
        opacity 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
        transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .rounded-full.border.t3d-in,
    .rounded-full.bg-ink.t3d-in,
    .rounded-full.bg-primary.t3d-in {
      opacity: 1;
      transform: perspective(400px) rotateX(0deg) scale(1);
    }

    /* FeatureCard wrapper — 3D flip entrance */
    .grid > div:has(> .feature-card),
    .grid > div:has(> [class*="FeatureCard"]) {
      opacity: 0;
      transform: perspective(900px) rotateY(-12deg) translateY(30px);
      transform-origin: left center;
      transition:
        opacity 0.7s cubic-bezier(0.23, 1, 0.32, 1),
        transform 0.7s cubic-bezier(0.23, 1, 0.32, 1);
      transition-delay: calc(var(--ti, 0) * 0.12s);
    }
    .grid > div:has(> .feature-card).t3d-in,
    .grid > div:has(> [class*="FeatureCard"]).t3d-in {
      opacity: 1;
      transform: perspective(900px) rotateY(0deg) translateY(0);
    }

    /* Footer — subtle 3D lift */
    footer {
      opacity: 0;
      transform: perspective(1000px) rotateX(3deg) translateY(40px);
      transform-origin: center bottom;
      transition:
        opacity 0.7s cubic-bezier(0.23, 1, 0.32, 1),
        transform 0.7s cubic-bezier(0.23, 1, 0.32, 1);
    }
    footer.t3d-in {
      opacity: 1;
      transform: perspective(1000px) rotateX(0deg) translateY(0);
    }

    /* Reduced motion */
    @media (prefers-reduced-motion: reduce) {
      main > section, main > article > section, article > section,
      .rounded-md.border, .rounded-lg.border, table,
      .grid > *, h1, ul li,
      .text-3xl.font-semibold, .text-2xl.font-semibold,
      .rounded-full.border, .rounded-full.bg-ink, .rounded-full.bg-primary,
      footer {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
    }
  </style>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      /* Auto-select every animatable element */
      const sels = [
        'main > section',
        'main > article > section',
        'article > section',
        '.rounded-md.border',
        '.rounded-lg.border',
        'table',
        '.grid > *',
        'h1',
        'ul li',
        '.text-3xl.font-semibold',
        '.text-2xl.font-semibold',
        '.rounded-full.border',
        '.rounded-full.bg-ink',
        '.rounded-full.bg-primary',
        'footer',
      ];
      const els = document.querySelectorAll(sels.join(','));
      if (!els.length) return;

      /* Assign stagger index to grid children */
      document.querySelectorAll('.grid').forEach(grid => {
        [...grid.children].forEach((child, i) => {
          child.style.setProperty('--ti', i);
        });
      });
      /* Assign stagger to list items */
      document.querySelectorAll('ul').forEach(ul => {
        [...ul.children].forEach((li, i) => {
          li.style.setProperty('--ti', i);
        });
      });

      const io = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('t3d-in');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
      els.forEach(el => io.observe(el));
    });
  </script>

</BaseHead>
