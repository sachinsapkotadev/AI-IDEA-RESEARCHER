---
import PublicLayout from '../../layouts/PublicLayout.astro';
import Badge from '../../components/Badge.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  });
}

const shareUrl = `https://aiidearesearcher.com/blog/${post.id}`;
const shareTitle = encodeURIComponent(post.data.title);
---

<PublicLayout title={`${post.data.title} — AI Idea Researcher`} description={post.data.description}>
  <article class="section-padding container-page">
    {/* Back link */}
    <a href="/blog" class="mb-8 inline-flex items-center gap-1.5 text-sm text-body no-underline transition-colors hover:text-ink">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      Back to blog
    </a>

    {/* Post header */}
    <header class="mx-auto max-w-3xl anim-fade-up">
      <div class="mb-4 flex flex-wrap items-center gap-2">
        <Badge variant="info">{post.data.category}</Badge>
        {post.data.tags?.map((tag) => (
          <Badge>{tag}</Badge>
        ))}
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl lg:text-5xl">
        {post.data.title}
      </h1>
      <p class="mt-4 text-lg text-body">{post.data.description}</p>
      <div class="mt-6 flex flex-wrap items-center gap-3 text-sm text-mute">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        <span>·</span>
        <span>{post.data.readingTime} read</span>
        <span>·</span>
        <span>{post.data.author}</span>
      </div>
    </header>

    {/* Post content */}
    <div class="prose-container mx-auto mt-10 max-w-3xl anim-fade-up">
      <Content />
    </div>

    {/* Share links */}
    <div class="mx-auto mt-12 max-w-3xl border-t border-hairline pt-8 anim-fade-up">
      <h3 class="mb-4 text-sm font-semibold text-ink">Share this post</h3>
      <div class="flex flex-wrap gap-3">
        <a
          href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareTitle}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-sm border border-hairline bg-canvas-elevated px-3 py-1.5 text-sm text-body no-underline transition-colors hover:text-ink"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" /></svg>
          Twitter / X
        </a>
        <a
          href={`https://www.linkedin.com/shareArticle?mini=true&url=${shareUrl}&title=${shareTitle}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-sm border border-hairline bg-canvas-elevated px-3 py-1.5 text-sm text-body no-underline transition-colors hover:text-ink"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" /></svg>
          LinkedIn
        </a>
        <a
          href={`mailto:?subject=${shareTitle}&body=Check out this article: ${shareUrl}`}
          class="inline-flex items-center gap-2 rounded-sm border border-hairline bg-canvas-elevated px-3 py-1.5 text-sm text-body no-underline transition-colors hover:text-ink"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Email
        </a>
      </div>
    </div>

    {/* Related posts */}
    {relatedPosts.length > 0 && (
      <section class="mx-auto mt-16 max-w-3xl border-t border-hairline pt-12 anim-fade-up">
        <h2 class="mb-6 text-xl font-bold text-ink">Continue reading</h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {relatedPosts.map((related, i) => (
            <a
              href={`/blog/${related.id}`}
              class="anim-item group flex flex-col rounded-lg border border-hairline bg-canvas-elevated p-5 transition-shadow hover:shadow-[var(--shadow-floating)] no-underline"
              style={`--i:${i}`}
            >
              <Badge class="mb-2">{related.data.category}</Badge>
              <h3 class="text-sm font-semibold text-ink transition-colors group-hover:text-link line-clamp-2">
                {related.data.title}
              </h3>
              <p class="mt-1.5 flex-1 text-xs text-body line-clamp-2">{related.data.description}</p>
              <div class="mt-3 text-xs text-mute">
                {related.data.readingTime} read
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>

  {/* Prose styles for blog content */}
  <style is:global>
    .prose-container h2 {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--color-ink);
      margin-top: 2.5rem;
      margin-bottom: 0.75rem;
      line-height: 1.3;
    }

    .prose-container h3 {
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--color-ink);
      margin-top: 2rem;
      margin-bottom: 0.5rem;
      line-height: 1.4;
    }

    .prose-container p {
      color: var(--color-body);
      line-height: 1.8;
      margin-bottom: 1.25rem;
    }

    .prose-container strong {
      color: var(--color-ink);
      font-weight: 600;
    }

    .prose-container ul,
    .prose-container ol {
      margin-bottom: 1.25rem;
      padding-left: 1.5rem;
    }

    .prose-container li {
      color: var(--color-body);
      line-height: 1.8;
      margin-bottom: 0.5rem;
    }

    .prose-container li strong {
      color: var(--color-ink);
    }

    .prose-container code {
      font-family: var(--font-mono);
      background-color: var(--color-hairline-soft);
      padding: 0.15rem 0.4rem;
      border-radius: 4px;
      font-size: 0.875em;
    }

    .prose-container pre {
      background-color: var(--color-ink);
      color: var(--color-canvas-elevated);
      border-radius: 8px;
      padding: 1.25rem;
      overflow-x: auto;
      margin-bottom: 1.25rem;
    }

    .prose-container pre code {
      background: none;
      padding: 0;
      color: inherit;
    }

    .prose-container blockquote {
      border-left: 3px solid var(--color-link);
      padding-left: 1rem;
      margin-left: 0;
      margin-bottom: 1.25rem;
      color: var(--color-body);
      font-style: italic;
    }

    .prose-container a {
      color: var(--color-link);
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    .prose-container a:hover {
      color: var(--color-link-deep);
    }

    .prose-container hr {
      border: none;
      border-top: 1px solid var(--color-hairline);
      margin: 2rem 0;
    }
  </style>
</PublicLayout>
