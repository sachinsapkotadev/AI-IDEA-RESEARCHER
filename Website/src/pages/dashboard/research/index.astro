---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Research — AI Idea Researcher">
  <div class="p-6 lg:p-8 max-w-6xl mx-auto space-y-6">
    {/* Header */}
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="text-2xl font-semibold text-ink">Research</h1>
        <p class="mt-1 text-sm text-body">Track and manage your research runs.</p>
      </div>
    </div>

    {/* Backend Status */}
    <div id="backend-status" class="hidden rounded-md border px-4 py-3 text-sm"></div>

    {/* Start Research Form */}
    <div class="rounded-md border border-hairline bg-canvas-elevated p-6">
      <h2 class="text-base font-semibold text-ink mb-4">Start New Research</h2>
      <form id="research-form" class="flex flex-col gap-4 sm:flex-row sm:items-end">
        <div class="flex-1">
          <label for="research-topic" class="block text-sm font-medium text-ink mb-1.5">
            Research Topic
          </label>
          <input
            type="text"
            id="research-topic"
            name="topic"
            required
            minlength="3"
            maxlength="500"
            placeholder="e.g. SaaS opportunities for small businesses"
            class="w-full rounded-sm border border-hairline bg-canvas-elevated px-3 py-2 text-sm text-ink placeholder-faint transition-colors focus:border-link focus:outline-none focus:ring-1 focus:ring-link"
          />
          <p id="topic-error" class="mt-1 text-xs text-error hidden"></p>
        </div>
        <button
          type="submit"
          id="submit-btn"
          class="inline-flex items-center justify-center rounded-sm bg-primary px-4 py-2 text-sm font-medium text-on-primary transition-opacity hover:opacity-90 disabled:opacity-50 disabled:pointer-events-none sm:self-end"
        >
          <svg class="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path d="M12 4v16m8-8H4" />
          </svg>
          Start Research
        </button>
      </form>
      <p id="form-message" class="mt-3 text-sm hidden"></p>
    </div>

    {/* Research History */}
    <section>
      <h2 class="text-lg font-semibold text-ink mb-4">Research History</h2>

      {/* Loading State */}
      <div id="loading-state" class="flex flex-col items-center justify-center py-16 text-center">
        <div class="mb-4 h-8 w-8 animate-spin rounded-full border-2 border-hairline border-t-link"></div>
        <p class="text-sm text-body">Loading research history...</p>
      </div>

      {/* Error State */}
      <div id="error-state" class="hidden flex flex-col items-center justify-center py-16 text-center">
        <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-red-50 text-error">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path d="M12 9v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-ink">Unable to connect</h3>
        <p id="error-message" class="mt-2 max-w-sm text-sm text-body"></p>
        <button
          onclick="window.location.reload()"
          class="mt-6 inline-flex items-center rounded-sm bg-primary px-4 py-2 text-sm font-medium text-on-primary transition-opacity hover:opacity-90"
        >
          Retry
        </button>
      </div>

      {/* Empty State */}
      <div id="empty-state" class="hidden flex flex-col items-center justify-center py-16 text-center">
        <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-hairline-soft text-mute">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <circle cx="11" cy="11" r="8" />
            <path d="M21 21l-4.35-4.35" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-ink">No research runs yet</h3>
        <p class="mt-2 max-w-sm text-sm text-body">Start your first research run to discover new ideas.</p>
      </div>

      {/* Research Table */}
      <div id="research-table" class="hidden rounded-md border border-hairline bg-canvas-elevated overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-hairline text-left">
              <th class="pb-3 pr-4 pl-4 font-medium text-mute">Topic</th>
              <th class="pb-3 pr-4 font-medium text-mute">Status</th>
              <th class="hidden pb-3 pr-4 font-medium text-mute sm:table-cell">Date</th>
              <th class="hidden pb-3 pr-4 font-medium text-mute md:table-cell">Sources</th>
              <th class="hidden pb-3 pr-4 font-medium text-mute lg:table-cell">Ideas</th>
              <th class="pb-3 pr-4 font-medium text-mute text-right">Action</th>
            </tr>
          </thead>
          <tbody id="research-tbody">
          </tbody>
        </table>
      </div>

      {/* Pagination */}
      <div id="pagination" class="hidden mt-4 flex items-center justify-between">
        <p id="pagination-info" class="text-sm text-mute"></p>
        <div class="flex gap-2">
          <button
            id="prev-page"
            class="rounded-sm border border-hairline bg-canvas-elevated px-3 py-1.5 text-sm text-body hover:bg-hairline-soft disabled:opacity-50 disabled:pointer-events-none"
            disabled
          >
            Previous
          </button>
          <button
            id="next-page"
            class="rounded-sm border border-hairline bg-canvas-elevated px-3 py-1.5 text-sm text-body hover:bg-hairline-soft disabled:opacity-50 disabled:pointer-events-none"
            disabled
          >
            Next
          </button>
        </div>
      </div>
    </section>
  </div>

  <script>
    const API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';

    const statusColors: Record<string, string> = {
      completed: 'bg-green-50 text-green-800 border-green-200',
      running: 'bg-link-soft text-blue-800 border-blue-200',
      pending: 'bg-warning-soft text-amber-800 border-amber-200',
      failed: 'bg-red-50 text-red-800 border-red-200',
    };

    let currentPage = 1;
    let totalPages = 1;

    // Elements
    const loadingEl = document.getElementById('loading-state')!;
    const errorEl = document.getElementById('error-state')!;
    const errorMsgEl = document.getElementById('error-message')!;
    const emptyEl = document.getElementById('empty-state')!;
    const tableEl = document.getElementById('research-table')!;
    const tbodyEl = document.getElementById('research-tbody')!;
    const paginationEl = document.getElementById('pagination')!;
    const paginationInfoEl = document.getElementById('pagination-info')!;
    const prevBtn = document.getElementById('prev-page') as HTMLButtonElement;
    const nextBtn = document.getElementById('next-page') as HTMLButtonElement;
    const form = document.getElementById('research-form') as HTMLFormElement;
    const topicInput = document.getElementById('research-topic') as HTMLInputElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const topicError = document.getElementById('topic-error')!;
    const formMessage = document.getElementById('form-message')!;
    const backendStatus = document.getElementById('backend-status')!;

    function showState(state: 'loading' | 'error' | 'empty' | 'table') {
      loadingEl.classList.toggle('hidden', state !== 'loading');
      errorEl.classList.toggle('hidden', state !== 'error');
      emptyEl.classList.toggle('hidden', state !== 'empty');
      tableEl.classList.toggle('hidden', state !== 'table');
      paginationEl.classList.toggle('hidden', state !== 'table');
    }

    function formatDate(iso: string) {
      return new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    }

    function showBackendStatus(connected: boolean) {
      backendStatus.classList.remove('hidden');
      if (connected) {
        backendStatus.className = 'rounded-md border border-green-200 bg-success-soft px-4 py-3 text-sm text-green-800';
        backendStatus.innerHTML = '<span class="font-medium">Connected</span> — backend is available.';
      } else {
        backendStatus.className = 'rounded-md border border-amber-200 bg-warning-soft px-4 py-3 text-sm text-amber-800';
        backendStatus.innerHTML = '<span class="font-medium">Backend unavailable</span> — start the backend server to use live data.';
      }
    }

    async function checkHealth() {
      try {
        const res = await fetch(`${API_BASE}/health`);
        if (res.ok) {
          showBackendStatus(true);
          return true;
        }
      } catch {}
      showBackendStatus(false);
      return false;
    }

    async function loadResearch(page = 1) {
      showState('loading');
      currentPage = page;

      try {
        const res = await fetch(`${API_BASE}/api/research?page=${page}&page_size=20`);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);

        const data = await res.json();
        const items = data.items || [];
        const total = data.total || 0;
        const pageSize = data.page_size || 20;
        totalPages = Math.ceil(total / pageSize) || 1;

        if (items.length === 0) {
          showState('empty');
          return;
        }

        renderTable(items);
        renderPagination(total, page, pageSize);
        showState('table');
      } catch (err) {
        const msg = err instanceof Error ? err.message : 'Unknown error';
        errorMsgEl.textContent = msg.includes('fetch')
          ? 'Unable to connect to the backend. Please check if the server is running.'
          : `Failed to load research: ${msg}`;
        showState('error');
      }
    }

    function renderTable(items: any[]) {
      tbodyEl.innerHTML = items.map((r: any) => {
        const colorClass = statusColors[r.status] || statusColors.pending;
        const ideasCount = r.result?.findings?.length ?? '—';
        const sourceCount = r.sources_found ?? '—';
        const date = formatDate(r.created_at);
        return `
          <tr class="border-b border-hairline-soft last:border-0 hover:bg-hairline-soft/50">
            <td class="py-3 pr-4 pl-4">
              <a href="/dashboard/research/${r.id}" class="font-medium text-ink no-underline hover:underline">${escapeHtml(r.topic)}</a>
            </td>
            <td class="py-3 pr-4">
              <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-medium ${colorClass}">${r.status}</span>
            </td>
            <td class="hidden py-3 pr-4 text-mute sm:table-cell">${date}</td>
            <td class="hidden py-3 pr-4 text-mute md:table-cell">${sourceCount}</td>
            <td class="hidden py-3 pr-4 text-mute lg:table-cell">${ideasCount}</td>
            <td class="py-3 pr-4 text-right">
              <a href="/dashboard/research/${r.id}" class="text-sm text-link font-medium no-underline hover:underline">View</a>
            </td>
          </tr>
        `;
      }).join('');
    }

    function renderPagination(total: number, page: number, pageSize: number) {
      const start = (page - 1) * pageSize + 1;
      const end = Math.min(page * pageSize, total);
      paginationInfoEl.textContent = `Showing ${start}–${end} of ${total} research runs`;
      prevBtn.disabled = page <= 1;
      nextBtn.disabled = page >= totalPages;
    }

    function escapeHtml(str: string) {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    // Form handling
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const topic = topicInput.value.trim();

      // Validation
      if (topic.length < 3) {
        topicError.textContent = 'Topic must be at least 3 characters.';
        topicError.classList.remove('hidden');
        return;
      }
      if (topic.length > 500) {
        topicError.textContent = 'Topic must be 500 characters or less.';
        topicError.classList.remove('hidden');
        return;
      }

      topicError.classList.add('hidden');
      formMessage.classList.add('hidden');
      submitBtn.disabled = true;
      submitBtn.innerHTML = `
        <div class="mr-2 h-4 w-4 animate-spin rounded-full border-2 border-on-primary border-t-transparent"></div>
        Starting...
      `;

      try {
        const res = await fetch(`${API_BASE}/api/research`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ topic }),
        });

        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          const msg = data.detail?.message || data.detail || `Request failed (${res.status})`;
          throw new Error(msg);
        }

        const result = await res.json();
        formMessage.textContent = `Research started! ID: ${result.id}`;
        formMessage.className = 'mt-3 text-sm text-green-800';
        formMessage.classList.remove('hidden');
        topicInput.value = '';

        // Reload the list
        loadResearch(1);
      } catch (err) {
        const msg = err instanceof Error ? err.message : 'Failed to start research';
        formMessage.textContent = msg;
        formMessage.className = 'mt-3 text-sm text-error';
        formMessage.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = `
          <svg class="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path d="M12 4v16m8-8H4" />
          </svg>
          Start Research
        `;
      }
    });

    // Clear error on input
    topicInput?.addEventListener('input', () => {
      topicError.classList.add('hidden');
    });

    // Pagination
    prevBtn?.addEventListener('click', () => {
      if (currentPage > 1) loadResearch(currentPage - 1);
    });
    nextBtn?.addEventListener('click', () => {
      if (currentPage < totalPages) loadResearch(currentPage + 1);
    });

    // Init
    checkHealth().then(() => loadResearch(1));
  </script>
</DashboardLayout>
