---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
---

<DashboardLayout title="AI Research Chat — AI Idea Researcher">
  <div class="p-6 lg:p-8 max-w-4xl mx-auto space-y-8">
    <Breadcrumbs items={[{ label: 'Dashboard', href: '/dashboard' }, { label: 'AI Research Chat' }]} class="mb-2" />

    <div>
      <h1 class="text-2xl font-semibold text-ink">AI Research Chat</h1>
      <p class="mt-1 text-sm text-body">
        Ask a research question. The AI breaks it into sub-queries, runs 5 agents in a loop,
        and delivers a comprehensive answer after deep analysis.
      </p>
    </div>

    {/* Chat Input */}
    <div class="rounded-md border border-hairline bg-canvas-elevated p-6">
      <form id="chat-form" class="space-y-4">
        <label for="chat-topic" class="block text-sm font-medium text-ink">
          What do you want to research?
        </label>
        <textarea
          id="chat-topic"
          name="topic"
          required
          minlength="3"
          maxlength="1000"
          rows={3}
          placeholder="e.g. What are the best SaaS opportunities in the AI productivity space for small businesses in 2026?"
          class="w-full rounded-sm border border-hairline bg-canvas px-3 py-2 text-sm text-ink placeholder-faint transition-colors focus:border-link focus:outline-none focus:ring-1 focus:ring-link"
        ></textarea>
        <div class="flex items-center justify-between">
          <p class="text-xs text-mute">Research runs for up to 12 hours · You can check back anytime</p>
          <button
            type="submit"
            id="chat-submit"
            class="inline-flex items-center gap-2 rounded-sm bg-primary px-4 py-2 text-sm font-medium text-on-primary transition-opacity hover:opacity-90 disabled:opacity-50 disabled:pointer-events-none"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            Start Deep Research
          </button>
        </div>
        <div id="chat-error" class="hidden text-sm text-error" role="alert"></div>
      </form>
    </div>

    {/* Job Status */}
    <div id="job-section" class="hidden space-y-6">
      {/* Progress */}
      <div class="rounded-md border border-hairline bg-canvas-elevated p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-semibold text-ink">Research Progress</h2>
          <div class="flex items-center gap-2">
            <button id="stop-btn" class="hidden inline-flex items-center gap-1 rounded-sm border border-hairline bg-canvas px-3 py-1.5 text-xs font-medium text-body hover:bg-hairline-soft">
              <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <rect x="6" y="6" width="12" height="12" rx="1" />
              </svg>
              Stop
            </button>
            <span id="job-status-badge" class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-medium bg-link-soft text-blue-800 border-blue-200">Running</span>
          </div>
        </div>

        {/* Progress Bar */}
        <div class="mb-4">
          <div class="flex justify-between text-sm mb-1">
            <span class="text-mute">Progress</span>
            <span id="progress-pct" class="text-ink font-medium">0%</span>
          </div>
          <div class="w-full h-2 rounded-full bg-hairline-soft">
            <div id="progress-bar" class="h-2 rounded-full bg-link transition-all duration-500" style="width: 0%"></div>
          </div>
        </div>

        {/* Stats Row */}
        <div class="grid grid-cols-4 gap-4 text-center">
          <div>
            <p id="stat-iteration" class="text-lg font-semibold text-ink">0</p>
            <p class="text-xs text-mute">Iteration</p>
          </div>
          <div>
            <p id="stat-sources" class="text-lg font-semibold text-ink">0</p>
            <p class="text-xs text-mute">Sources</p>
          </div>
          <div>
            <p id="stat-agents" class="text-lg font-semibold text-ink">0</p>
            <p class="text-xs text-mute">Agents Run</p>
          </div>
          <div>
            <p id="stat-elapsed" class="text-lg font-semibold text-ink">0h</p>
            <p class="text-xs text-mute">Elapsed</p>
          </div>
        </div>
      </div>

      {/* Sub-Queries */}
      <div class="rounded-md border border-hairline bg-canvas-elevated p-6">
        <h3 class="text-sm font-semibold text-ink mb-3">Active Sub-Queries</h3>
        <div id="sub-queries" class="space-y-2"></div>
      </div>

      {/* Iteration Log */}
      <div class="rounded-md border border-hairline bg-canvas-elevated p-6">
        <h3 class="text-sm font-semibold text-ink mb-3">Recent Activity</h3>
        <div id="iteration-log" class="space-y-2 max-h-64 overflow-y-auto"></div>
      </div>
    </div>

    {/* Final Answer */}
    <div id="answer-section" class="hidden rounded-md border border-hairline bg-canvas-elevated p-6">
      <h2 class="text-lg font-semibold text-ink mb-4">Research Results</h2>
      <div id="final-answer" class="prose prose-sm max-w-none text-body whitespace-pre-wrap"></div>
      <div class="mt-4 pt-4 border-t border-hairline flex items-center gap-4">
        <button id="copy-btn" class="inline-flex items-center gap-1 rounded-sm border border-hairline bg-canvas px-3 py-1.5 text-sm font-medium text-body hover:bg-hairline-soft">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
            <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" />
          </svg>
          Copy Answer
        </button>
        <button id="new-research-btn" class="inline-flex items-center gap-1 rounded-sm bg-primary px-4 py-2 text-sm font-medium text-on-primary hover:opacity-90">
          New Research
        </button>
      </div>
    </div>

    {/* Previous Jobs */}
    <section>
      <h2 class="text-lg font-semibold text-ink mb-4">Previous Research Jobs</h2>
      <div id="previous-jobs" class="rounded-md border border-hairline bg-canvas-elevated">
        <p class="p-4 text-sm text-mute">Loading...</p>
      </div>
    </section>
  </div>

  <script>
    const API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';

    let currentJobId: string | null = null;
    let pollInterval: ReturnType<typeof setInterval> | null = null;

    const chatForm = document.getElementById('chat-form') as HTMLFormElement;
    const chatTopic = document.getElementById('chat-topic') as HTMLTextAreaElement;
    const chatSubmit = document.getElementById('chat-submit') as HTMLButtonElement;
    const chatError = document.getElementById('chat-error')!;
    const jobSection = document.getElementById('job-section')!;
    const answerSection = document.getElementById('answer-section')!;
    const stopBtn = document.getElementById('stop-btn')!;
    const copyBtn = document.getElementById('copy-btn')!;
    const newResearchBtn = document.getElementById('new-research-btn')!;
    const previousJobsEl = document.getElementById('previous-jobs')!;

    function statusBadge(status: string) {
      const colors: Record<string, string> = {
        running: 'bg-blue-50 text-blue-800 border-blue-200',
        completed: 'bg-green-50 text-green-800 border-green-200',
        failed: 'bg-red-50 text-red-800 border-red-200',
        stopped: 'bg-amber-50 text-amber-800 border-amber-200',
        pending: 'bg-gray-50 text-gray-800 border-gray-200',
      };
      return `<span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-medium ${colors[status] || colors.pending}">${status}</span>`;
    }

    function updateUI(data: any) {
      // Progress
      document.getElementById('progress-pct')!.textContent = `${data.progress_pct || 0}%`;
      document.getElementById('progress-bar')!.style.width = `${data.progress_pct || 0}%`;
      document.getElementById('stat-iteration')!.textContent = `${data.current_iteration || 0}/${data.max_iterations || 20}`;
      document.getElementById('stat-sources')!.textContent = String(data.sources_collected || 0);
      document.getElementById('stat-agents')!.textContent = String(data.agents_run || 0);
      document.getElementById('stat-elapsed')!.textContent = `${data.elapsed_hours || 0}h`;

      // Status badge
      const badge = document.getElementById('job-status-badge')!;
      badge.outerHTML = statusBadge(data.status);
      badge.id = 'job-status-badge';

      // Stop button
      stopBtn.classList.toggle('hidden', data.status !== 'running');

      // Sub-queries
      const subQueriesEl = document.getElementById('sub-queries')!;
      if (data.sub_queries?.length) {
        subQueriesEl.innerHTML = data.sub_queries.map((q: string, i: number) => `
          <div class="flex items-start gap-2">
            <span class="flex-shrink-0 mt-0.5 h-5 w-5 rounded-full bg-hairline-soft text-center text-xs font-medium text-body leading-5">${i + 1}</span>
            <span class="text-sm text-ink">${escapeHtml(q)}</span>
          </div>
        `).join('');
      }

      // Iteration log
      const logEl = document.getElementById('iteration-log')!;
      if (data.iteration_log?.length) {
        logEl.innerHTML = data.iteration_log.map((log: any) => `
          <div class="flex items-center gap-3 rounded-sm border border-hairline-soft px-3 py-2 text-xs">
            <span class="flex-shrink-0 font-mono text-mute">Iter ${log.iteration}</span>
            <span class="text-mute">${log.new_sources || 0} sources</span>
            <span class="text-mute">${log.agents_completed?.length || 0} agents</span>
            <span class="text-mute">${log.findings_count || 0} findings</span>
          </div>
        `).join('');
        logEl.scrollTop = logEl.scrollHeight;
      }

      // Final answer
      if (data.status === 'completed' && data.final_answer) {
        answerSection.classList.remove('hidden');
        document.getElementById('final-answer')!.textContent = data.final_answer;
        if (pollInterval) clearInterval(pollInterval);
      }

      // Failed
      if (data.status === 'failed') {
        chatError.textContent = data.error || 'Research failed';
        chatError.classList.remove('hidden');
        if (pollInterval) clearInterval(pollInterval);
      }
    }

    async function pollJob() {
      if (!currentJobId) return;
      try {
        const res = await fetch(`${API_BASE}/api/deep-research/${currentJobId}`, { signal: AbortSignal.timeout(10000) });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        updateUI(data);
      } catch (err) {
        console.error('Poll failed:', err);
      }
    }

    async function loadPreviousJobs() {
      try {
        const res = await fetch(`${API_BASE}/api/deep-research`, { signal: AbortSignal.timeout(8000) });
        if (!res.ok) return;
        const data = await res.json();
        const jobs = data.jobs || [];

        if (jobs.length === 0) {
          previousJobsEl.innerHTML = '<p class="p-4 text-sm text-mute">No previous research jobs.</p>';
          return;
        }

        previousJobsEl.innerHTML = jobs.map((j: any) => `
          <div class="flex items-center justify-between border-b border-hairline-soft px-4 py-3 last:border-0 hover:bg-hairline-soft/50">
            <div class="min-w-0 flex-1">
              <p class="text-sm font-medium text-ink truncate">${escapeHtml(j.topic)}</p>
              <p class="text-xs text-mute">Iter ${j.current_iteration} · ${j.sources_collected} sources · ${j.elapsed_hours}h</p>
            </div>
            <div class="flex items-center gap-3 ml-4">
              ${statusBadge(j.status)}
              ${j.status === 'completed' ? `<button onclick="viewJob('${j.job_id}')" class="text-xs text-link font-medium hover:underline">View</button>` : ''}
            </div>
          </div>
        `).join('');
      } catch {
        previousJobsEl.innerHTML = '<p class="p-4 text-sm text-mute">Unable to load jobs.</p>';
      }
    }

    function escapeHtml(str: string) {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    // Start research
    chatForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const topic = chatTopic.value.trim();
      if (topic.length < 3) {
        chatError.textContent = 'Topic must be at least 3 characters.';
        chatError.classList.remove('hidden');
        return;
      }

      chatError.classList.add('hidden');
      answerSection.classList.add('hidden');
      chatSubmit.disabled = true;
      chatSubmit.textContent = 'Starting...';

      try {
        const res = await fetch(`${API_BASE}/api/deep-research`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ topic }),
        });

        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          throw new Error(data.detail?.message || `Request failed (${res.status})`);
        }

        const result = await res.json();
        currentJobId = result.job_id;
        jobSection.classList.remove('hidden');

        // Start polling
        pollInterval = setInterval(pollJob, 5000);
        pollJob(); // Immediate first poll

      } catch (err) {
        chatError.textContent = err instanceof Error ? err.message : 'Failed to start research';
        chatError.classList.remove('hidden');
      } finally {
        chatSubmit.disabled = false;
        chatSubmit.innerHTML = `
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          Start Deep Research
        `;
      }
    });

    // Stop research
    stopBtn?.addEventListener('click', async () => {
      if (!currentJobId) return;
      try {
        await fetch(`${API_BASE}/api/deep-research/${currentJobId}/stop`, { method: 'POST' });
      } catch {}
    });

    // Copy answer
    copyBtn?.addEventListener('click', () => {
      const answer = document.getElementById('final-answer')?.textContent || '';
      navigator.clipboard.writeText(answer);
      copyBtn.textContent = 'Copied!';
      setTimeout(() => {
        copyBtn.innerHTML = `<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2" /><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" /></svg> Copy Answer`;
      }, 2000);
    });

    // New research
    newResearchBtn?.addEventListener('click', () => {
      currentJobId = null;
      jobSection.classList.add('hidden');
      answerSection.classList.add('hidden');
      chatTopic.value = '';
      chatTopic.focus();
      loadPreviousJobs();
    });

    // View job (global for onclick)
    (window as any).viewJob = async (jobId: string) => {
      currentJobId = jobId;
      jobSection.classList.remove('hidden');
      answerSection.classList.add('hidden');
      pollJob();
      if (pollInterval) clearInterval(pollInterval);
      pollInterval = setInterval(pollJob, 5000);
    };

    // Init
    loadPreviousJobs();
  </script>
</DashboardLayout>
