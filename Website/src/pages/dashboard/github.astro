---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Card from '../../components/Card.astro';
import Badge from '../../components/Badge.astro';
---

<DashboardLayout title="GitHub — AI Idea Researcher">
  <div class="p-6 lg:p-8 max-w-6xl mx-auto space-y-6">
    {/* Header */}
    <div>
      <h1 class="text-2xl font-semibold text-ink">GitHub</h1>
      <p class="mt-1 text-sm text-body">Manage your GitHub integration for pushing research reports.</p>
    </div>

    {/* Status Banner */}
    <div class="rounded-md border border-amber-200 bg-warning-soft px-4 py-3 text-sm text-amber-800">
      <span class="font-medium">GitHub integration requires backend configuration.</span> Connect a repository to enable automatic report syncing.
    </div>

    {/* Connection Status */}
    <Card padding="md">
      <div class="flex items-center gap-4">
        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-hairline-soft">
          <svg class="h-5 w-5 text-ink" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </div>
        <div class="flex-1">
          <div class="flex items-center gap-3">
            <h3 class="text-sm font-semibold text-ink">GitHub Connection</h3>
            <Badge variant="default">Not Connected</Badge>
          </div>
          <p class="mt-1 text-xs text-body">
            Connect a GitHub repository to push research reports.
          </p>
        </div>
      </div>
    </Card>

    {/* Repository Info */}
    <Card padding="md">
      <h3 class="text-sm font-semibold text-ink mb-3">Repository</h3>
      <p class="text-sm text-mute">No repository configured. Connect a GitHub repository to start syncing reports.</p>
    </Card>

    {/* Recent Branches */}
    <section>
      <h3 class="text-sm font-semibold text-ink mb-4">Recent Branches</h3>
      <div class="rounded-md border border-dashed border-hairline bg-canvas-elevated p-8 text-center">
        <p class="text-sm text-mute">No branches yet.</p>
        <p class="mt-1 text-xs text-faint">Branches will appear here once reports are pushed to GitHub.</p>
      </div>
    </section>
  </div>
</DashboardLayout>
