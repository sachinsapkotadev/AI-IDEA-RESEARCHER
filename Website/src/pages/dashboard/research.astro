---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Card from '../../components/Card.astro';
import Badge from '../../components/Badge.astro';
import Button from '../../components/Button.astro';
import EmptyState from '../../components/EmptyState.astro';
import { DEMO_RESEARCH } from '../../lib/api/demo';

const statusColors: Record<string, 'success' | 'warning' | 'error' | 'info'> = {
  completed: 'success',
  running: 'info',
  pending: 'warning',
  failed: 'error',
};

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

function formatDuration(seconds?: number) {
  if (!seconds) return '—';
  const m = Math.round(seconds / 60);
  return `${m}m`;
}
---

<DashboardLayout title="Research — AI Idea Researcher">
  <div class="p-6 lg:p-8 max-w-6xl mx-auto space-y-6">
    {/* Header */}
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="text-2xl font-semibold text-ink">Research</h1>
        <p class="mt-1 text-sm text-body">Track and manage your research runs.</p>
      </div>
      <Button onclick="alert('Start Research — connect backend to enable')">
        <svg class="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M12 4v16m8-8H4" />
        </svg>
        Start Research
      </Button>
    </div>

    {/* Demo Banner */}
    <div class="rounded-md border border-amber-200 bg-warning-soft px-4 py-3 text-sm text-amber-800">
      <span class="font-medium">Demo mode</span> — showing sample research data.
    </div>

    {/* Research Table */}
    {DEMO_RESEARCH.length === 0 ? (
      <EmptyState
        icon='<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>'
        title="No research runs yet"
        description="Start your first research run to discover new ideas."
        actionLabel="Start Research"
        actionHref="#"
      />
    ) : (
      <Card padding="sm" class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-hairline text-left">
              <th class="pb-3 pr-4 font-medium text-mute">Topic</th>
              <th class="pb-3 pr-4 font-medium text-mute">Status</th>
              <th class="hidden pb-3 pr-4 font-medium text-mute sm:table-cell">Date</th>
              <th class="hidden pb-3 pr-4 font-medium text-mute md:table-cell">Duration</th>
              <th class="hidden pb-3 font-medium text-mute md:table-cell">Ideas</th>
            </tr>
          </thead>
          <tbody>
            {DEMO_RESEARCH.map((r) => (
              <tr class="border-b border-hairline-soft last:border-0">
                <td class="py-3 pr-4">
                  <p class="font-medium text-ink">{r.topic}</p>
                </td>
                <td class="py-3 pr-4">
                  <Badge variant={statusColors[r.status]}>{r.status}</Badge>
                </td>
                <td class="hidden py-3 pr-4 text-mute sm:table-cell">{formatDate(r.created_at)}</td>
                <td class="hidden py-3 pr-4 text-mute md:table-cell">{formatDuration(r.duration)}</td>
                <td class="hidden py-3 text-mute md:table-cell">{r.ideas_count ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </Card>
    )}
  </div>
</DashboardLayout>
