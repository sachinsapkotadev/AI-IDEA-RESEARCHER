---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const hour = new Date().getHours();
const greeting = hour < 12 ? 'Good morning' : hour < 18 ? 'Good afternoon' : 'Good evening';
---

<DashboardLayout title="Dashboard — AI Idea Researcher">
  <div class="p-6 lg:p-8 max-w-6xl mx-auto space-y-8">
    <Breadcrumbs items={[{ label: 'Dashboard' }]} class="mb-2" />

    {/* Backend Status */}
    <div id="backend-status" class="hidden rounded-md border px-4 py-3 text-sm" role="status" aria-live="polite"></div>

    {/* Greeting + Quick Research */}
    <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
      <div>
        <h1 class="text-2xl font-semibold text-ink">{greeting}, User</h1>
        <p class="mt-1 text-sm text-body">Here's what's happening with your research today.</p>
      </div>

      {/* Quick Research */}
      <div class="w-full max-w-md flex-shrink-0">
        <form id="quick-research-form" class="flex flex-col gap-3">
          <label for="quick-topic" class="text-sm font-medium text-ink">
            What do you want to research?
          </label>
          <div class="flex gap-2">
            <input
              type="text"
              id="quick-topic"
              name="topic"
              required
              minlength="3"
              maxlength="500"
              placeholder="e.g. SaaS opportunities for small businesses"
              class="flex-1 rounded-sm border border-hairline bg-canvas-elevated px-3 py-2 text-sm text-ink placeholder-faint transition-colors focus:border-link focus:outline-none focus:ring-1 focus:ring-link"
              aria-describedby="quick-topic-hint"
            />
            <button
              type="submit"
              id="quick-submit-btn"
              class="inline-flex items-center justify-center rounded-sm bg-primary px-4 py-2 text-sm font-medium text-on-primary transition-opacity hover:opacity-90 disabled:opacity-50 disabled:pointer-events-none"
            >
              Start Research
            </button>
          </div>
          <p id="quick-topic-hint" class="text-xs text-mute">Press Enter or click to start researching</p>
          <div id="quick-form-message" class="hidden text-sm" role="alert" aria-live="assertive"></div>
        </form>
      </div>
    </div>

    {/* Stats Grid — real data only */}
    <div class="grid grid-cols-2 gap-4 lg:grid-cols-3">
      <div class="rounded-md border border-hairline bg-canvas-elevated p-5">
        <p class="text-sm text-mute">Research Runs</p>
        <p id="stat-research" class="mt-1 text-2xl font-semibold text-ink">—</p>
        <p id="stat-research-detail" class="mt-1 text-xs text-mute">Loading...</p>
      </div>
      <div class="rounded-md border border-hairline bg-canvas-elevated p-5">
        <p class="text-sm text-mute">Sources Collected</p>
        <p id="stat-sources" class="mt-1 text-2xl font-semibold text-ink">—</p>
        <p id="stat-sources-detail" class="mt-1 text-xs text-mute">Loading...</p>
      </div>
      <div class="rounded-md border border-hairline bg-canvas-elevated p-5">
        <p class="text-sm text-mute">Backend</p>
        <p id="stat-backend" class="mt-1 text-2xl font-semibold text-ink">Checking...</p>
        <p id="stat-backend-detail" class="mt-1 text-xs text-mute">Verifying connection</p>
      </div>
    </div>

    {/* Recent Research */}
    <section aria-labelledby="recent-research-heading">
      <div class="flex items-center justify-between mb-4">
        <h2 id="recent-research-heading" class="text-lg font-semibold text-ink">Recent Research</h2>
        <a href="/dashboard/research" class="text-sm text-link font-medium no-underline hover:underline">View all →</a>
      </div>

      {/* Loading skeleton */}
      <div id="research-loading" class="rounded-md border border-hairline bg-canvas-elevated">
        <div class="animate-pulse">
          <div class="border-b border-hairline-soft px-4 py-3">
            <div class="flex gap-4">
              <div class="h-3 w-1/3 rounded bg-hairline-soft"></div>
              <div class="h-3 w-16 rounded bg-hairline-soft"></div>
              <div class="h-3 w-16 rounded bg-hairline-soft"></div>
            </div>
          </div>
          {Array.from({ length: 3 }).map(() => (
            <div class="border-b border-hairline-soft px-4 py-3 last:border-b-0">
              <div class="flex gap-4">
                <div class="h-3 w-2/5 rounded bg-hairline-soft"></div>
                <div class="h-3 w-16 rounded bg-hairline-soft"></div>
                <div class="h-3 w-12 rounded bg-hairline-soft"></div>
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* Error state */}
      <div id="research-error" class="hidden rounded-md border border-hairline bg-canvas-elevated p-8 text-center">
        <div class="mb-3 flex justify-center">
          <div class="flex h-10 w-10 items-center justify-center rounded-full bg-red-50 text-error">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M12 9v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
        </div>
        <p class="text-sm text-body">Unable to connect to the research backend.</p>
        <p class="mt-1 text-xs text-mute">Start the backend server to see live data.</p>
        <button
          onclick="window.location.reload()"
          class="mt-4 inline-flex items-center rounded-sm border border-hairline bg-canvas-elevated px-3 py-1.5 text-sm text-body hover:bg-hairline-soft"
        >
          Retry
        </button>
      </div>

      {/* Empty state */}
      <div id="research-empty" class="hidden rounded-md border border-dashed border-hairline bg-canvas-elevated p-8 text-center">
        <div class="mb-3 flex justify-center">
          <div class="flex h-10 w-10 items-center justify-center rounded-full bg-hairline-soft text-mute">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <circle cx="11" cy="11" r="8" />
              <path d="M21 21l-4.35-4.35" />
            </svg>
          </div>
        </div>
        <p class="text-sm font-medium text-ink">No research runs yet</p>
        <p class="mt-1 text-xs text-mute">Start your first research run to discover new ideas.</p>
        <a href="/dashboard/research" class="mt-4 inline-flex items-center rounded-sm bg-primary px-4 py-2 text-sm font-medium text-on-primary no-underline transition-opacity hover:opacity-90">
          Start Research
        </a>
      </div>

      {/* Table */}
      <div id="research-table" class="hidden rounded-md border border-hairline bg-canvas-elevated overflow-x-auto">
        <table class="w-full text-sm" aria-label="Recent research runs">
          <thead>
            <tr class="border-b border-hairline text-left">
              <th scope="col" class="pb-3 pr-4 pl-4 font-medium text-mute">Topic</th>
              <th scope="col" class="pb-3 pr-4 font-medium text-mute">Status</th>
              <th scope="col" class="hidden pb-3 pr-4 font-medium text-mute sm:table-cell">Date</th>
              <th scope="col" class="hidden pb-3 pr-4 font-medium text-mute md:table-cell">Sources</th>
              <th scope="col" class="pb-3 pr-4 font-medium text-mute text-right">Action</th>
            </tr>
          </thead>
          <tbody id="research-tbody"></tbody>
        </table>
      </div>
    </section>

    {/* Quick Actions */}
    <section aria-labelledby="quick-actions-heading">
      <h2 id="quick-actions-heading" class="text-lg font-semibold text-ink mb-4">Quick Actions</h2>
      <div class="grid gap-4 sm:grid-cols-3">
        <a href="/dashboard/research" class="flex items-center gap-3 rounded-md border border-hairline bg-canvas-elevated p-4 no-underline transition-colors hover:bg-hairline-soft">
          <div class="flex h-10 w-10 items-center justify-center rounded-full bg-hairline-soft">
            <svg class="h-5 w-5 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8" /><path d="M21 21l-4.35-4.35" />
            </svg>
          </div>
          <div>
            <p class="text-sm font-medium text-ink">New Research</p>
            <p class="text-xs text-mute">Start a research run</p>
          </div>
        </a>
        <a href="/dashboard/ideas" class="flex items-center gap-3 rounded-md border border-hairline bg-canvas-elevated p-4 no-underline transition-colors hover:bg-hairline-soft">
          <div class="flex h-10 w-10 items-center justify-center rounded-full bg-hairline-soft">
            <svg class="h-5 w-5 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
            </svg>
          </div>
          <div>
            <p class="text-sm font-medium text-ink">Browse Ideas</p>
            <p class="text-xs text-mute">View discovered ideas</p>
          </div>
        </a>
        <a href="/dashboard/settings" class="flex items-center gap-3 rounded-md border border-hairline bg-canvas-elevated p-4 no-underline transition-colors hover:bg-hairline-soft">
          <div class="flex h-10 w-10 items-center justify-center rounded-full bg-hairline-soft">
            <svg class="h-5 w-5 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <circle cx="12" cy="12" r="3" />
            </svg>
          </div>
          <div>
            <p class="text-sm font-medium text-ink">Settings</p>
            <p class="text-xs text-mute">Configure your account</p>
          </div>
        </a>
      </div>
    </section>
  </div>

  <script>
    const API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';

    const statusConfig: Record<string, { classes: string; label: string }> = {
      completed: { classes: 'bg-success-soft text-green-800 border-green-200', label: 'Completed' },
      running:   { classes: 'bg-link-soft text-blue-800 border-blue-200',     label: 'Running' },
      pending:   { classes: 'bg-warning-soft text-amber-800 border-amber-200', label: 'Pending' },
      failed:    { classes: 'bg-red-50 text-red-800 border-red-200',          label: 'Failed' },
    };

    const backendStatusEl = document.getElementById('backend-status')!;
    const statResearch = document.getElementById('stat-research')!;
    const statResearchDetail = document.getElementById('stat-research-detail')!;
    const statSources = document.getElementById('stat-sources')!;
    const statSourcesDetail = document.getElementById('stat-sources-detail')!;
    const statBackend = document.getElementById('stat-backend')!;
    const statBackendDetail = document.getElementById('stat-backend-detail')!;
    const researchLoading = document.getElementById('research-loading')!;
    const researchError = document.getElementById('research-error')!;
    const researchEmpty = document.getElementById('research-empty')!;
    const researchTable = document.getElementById('research-table')!;
    const researchTbody = document.getElementById('research-tbody')!;

    function showResearchState(state: 'loading' | 'error' | 'empty' | 'table') {
      researchLoading.classList.toggle('hidden', state !== 'loading');
      researchError.classList.toggle('hidden', state !== 'error');
      researchEmpty.classList.toggle('hidden', state !== 'empty');
      researchTable.classList.toggle('hidden', state !== 'table');
    }

    function formatDate(iso: string) {
      return new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    }

    function escapeHtml(str: string) {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    async function init() {
      // Check health
      let isHealthy = false;
      try {
        const res = await fetch(`${API_BASE}/health`, { signal: AbortSignal.timeout(5000) });
        isHealthy = res.ok;
      } catch {}

      // Backend status banner
      backendStatusEl.classList.remove('hidden');
      if (isHealthy) {
        backendStatusEl.className = 'rounded-md border border-green-200 bg-success-soft px-4 py-3 text-sm text-green-800';
        backendStatusEl.innerHTML = '<span class="font-medium">Connected</span> — backend is available.';
        statBackend.textContent = 'Online';
        statBackendDetail.textContent = 'Connected';
        statBackendDetail.className = 'mt-1 text-xs font-medium text-green-800';
      } else {
        backendStatusEl.className = 'rounded-md border border-amber-200 bg-warning-soft px-4 py-3 text-sm text-amber-800';
        backendStatusEl.innerHTML = '<span class="font-medium">Backend unavailable</span> — start the backend server for live data.';
        statBackend.textContent = 'Offline';
        statBackendDetail.textContent = 'Not connected';
        statBackendDetail.className = 'mt-1 text-xs font-medium text-amber-800';
      }

      // Load research list
      try {
        const res = await fetch(`${API_BASE}/api/research?page=1&page_size=5`, { signal: AbortSignal.timeout(10000) });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);

        const data = await res.json();
        const items = data.items || [];
        const total = data.total || 0;

        // Update stats with real data
        statResearch.textContent = String(total);
        statResearchDetail.textContent = total === 1 ? '1 run total' : `${total} runs total`;

        let totalSources = 0;
        items.forEach((r: any) => { totalSources += r.sources_found || 0; });
        statSources.textContent = String(totalSources);
        statSourcesDetail.textContent = `From ${items.length} recent runs`;

        if (items.length === 0) {
          showResearchState('empty');
          return;
        }

        researchTbody.innerHTML = items.map((r: any) => {
          const config = statusConfig[r.status] || statusConfig.pending;
          return `
            <tr class="border-b border-hairline-soft last:border-0 hover:bg-hairline-soft/50">
              <td class="py-3 pr-4 pl-4">
                <a href="/dashboard/research/view?id=${r.id}" class="font-medium text-ink no-underline hover:underline">${escapeHtml(r.topic)}</a>
              </td>
              <td class="py-3 pr-4">
                <span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-xs font-medium ${config.classes}">
                  <span class="h-1.5 w-1.5 rounded-full" aria-hidden="true"></span>
                  ${config.label}
                </span>
              </td>
              <td class="hidden py-3 pr-4 text-mute sm:table-cell">${formatDate(r.created_at)}</td>
              <td class="hidden py-3 pr-4 text-mute md:table-cell">${r.sources_found ?? '—'}</td>
              <td class="py-3 pr-4 text-right">
                <a href="/dashboard/research/view?id=${r.id}" class="text-sm text-link font-medium no-underline hover:underline">View</a>
              </td>
            </tr>
          `;
        }).join('');

        showResearchState('table');
      } catch {
        showResearchState('error');
      }
    }

    // Quick research form
    const quickForm = document.getElementById('quick-research-form') as HTMLFormElement;
    const quickTopicInput = document.getElementById('quick-topic') as HTMLInputElement;
    const quickSubmitBtn = document.getElementById('quick-submit-btn') as HTMLButtonElement;
    const quickFormMessage = document.getElementById('quick-form-message')!;

    quickForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const topic = quickTopicInput.value.trim();

      if (topic.length < 3) {
        quickFormMessage.textContent = 'Topic must be at least 3 characters.';
        quickFormMessage.className = 'text-sm text-error';
        quickFormMessage.classList.remove('hidden');
        return;
      }

      quickFormMessage.classList.add('hidden');
      quickSubmitBtn.disabled = true;
      quickSubmitBtn.textContent = 'Starting...';

      try {
        const res = await fetch(`${API_BASE}/api/research`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ topic }),
        });

        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          const msg = data.detail?.message || data.detail || `Request failed (${res.status})`;
          throw new Error(msg);
        }

        const result = await res.json();
        window.location.href = `/dashboard/research/view?id=${result.id}`;
      } catch (err) {
        const msg = err instanceof Error ? err.message : 'Failed to start research';
        quickFormMessage.textContent = msg;
        quickFormMessage.className = 'text-sm text-error';
        quickFormMessage.classList.remove('hidden');
        quickSubmitBtn.disabled = false;
        quickSubmitBtn.textContent = 'Start Research';
      }
    });

    init();
  </script>
</DashboardLayout>
