---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import StatusBadge from '../../components/StatusBadge.astro';
---

<DashboardLayout title="Models — AI Idea Researcher">
  <div class="p-6 lg:p-8 max-w-6xl mx-auto space-y-6">
    <Breadcrumbs items={[
      { label: 'Dashboard', href: '/dashboard' },
      { label: 'Models' },
    ]} />

    {/* Header */}
    <div>
      <h1 class="text-2xl font-semibold text-ink">Models</h1>
      <p class="mt-1 text-sm text-body">AI models configured for research and analysis tasks.</p>
    </div>

    {/* Status Banner */}
    <div class="rounded-md border border-blue-200 bg-link-soft px-4 py-3 text-sm text-blue-800" role="status">
      <span class="font-medium">Model registry not connected.</span> Model health checks and priority routing will be available when the backend exposes model configuration endpoints.
    </div>

    {/* Known models from backend config */}
    <div class="rounded-md border border-hairline bg-canvas-elevated p-6">
      <h2 class="text-base font-semibold text-ink mb-4">Configured Providers</h2>
      <p class="text-sm text-body mb-4">The backend uses the following AI provider via OpenRouter. Models are configured server-side.</p>
      <div class="space-y-3">
        <div class="flex items-center gap-3 rounded-sm border border-hairline-soft p-3">
          <div class="flex h-8 w-8 items-center justify-center rounded-full bg-hairline-soft">
            <svg class="h-4 w-4 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <div class="flex-1">
            <div class="flex items-center gap-2">
              <p class="text-sm font-medium text-ink">OpenRouter</p>
              <StatusBadge status="not-connected" label="Server-side" />
            </div>
            <p class="mt-0.5 text-xs text-mute">AI provider gateway — models configured server-side via API key</p>
          </div>
        </div>
      </div>
    </div>

    {/* Future features preview */}
    <div class="grid gap-4 md:grid-cols-2">
      <div class="rounded-md border border-dashed border-hairline bg-canvas-elevated p-6 text-center">
        <p class="text-sm font-medium text-mute">Model health checks</p>
        <p class="mt-1 text-xs text-faint">Monitor model availability and latency</p>
      </div>
      <div class="rounded-md border border-dashed border-hairline bg-canvas-elevated p-6 text-center">
        <p class="text-sm font-medium text-mute">Priority routing</p>
        <p class="mt-1 text-xs text-faint">Configure model selection and fallbacks</p>
      </div>
    </div>
  </div>
</DashboardLayout>
