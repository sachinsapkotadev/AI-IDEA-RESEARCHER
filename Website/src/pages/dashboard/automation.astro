---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Card from '../../components/Card.astro';
import Badge from '../../components/Badge.astro';
---

<DashboardLayout title="Automation — AI Idea Researcher">
  <div class="p-6 lg:p-8 max-w-6xl mx-auto space-y-6">
    {/* Header */}
    <div>
      <h1 class="text-2xl font-semibold text-ink">Automation</h1>
      <p class="mt-1 text-sm text-body">Configure scheduled research runs and notifications.</p>
    </div>

    {/* Status Banner */}
    <div class="rounded-md border border-amber-200 bg-warning-soft px-4 py-3 text-sm text-amber-800">
      <span class="font-medium">Not configured.</span> Automation requires the backend scheduler to be implemented.
    </div>

    <div class="grid gap-6 lg:grid-cols-2">
      {/* Daily Research Toggle */}
      <Card padding="md">
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <div>
              <h3 class="text-sm font-semibold text-ink">Daily Research</h3>
              <p class="mt-0.5 text-xs text-body">Automatically run research on configured topics.</p>
            </div>
            <Badge variant="default">Not configured</Badge>
          </div>
          <div class="border-t border-hairline-soft pt-3">
            <p class="text-xs text-mute">Schedule</p>
            <p class="text-sm text-mute">Not configured</p>
          </div>
        </div>
      </Card>

      {/* Status */}
      <Card padding="md">
        <div class="space-y-4">
          <div>
            <h3 class="text-sm font-semibold text-ink mb-3">Status</h3>
            <div class="flex items-center gap-3">
              <Badge variant="default">Not configured</Badge>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4 border-t border-hairline-soft pt-3">
            <div>
              <p class="text-xs text-mute">Last Run</p>
              <p class="text-sm text-mute">—</p>
            </div>
            <div>
              <p class="text-xs text-mute">Next Run</p>
              <p class="text-sm text-mute">—</p>
            </div>
          </div>
        </div>
      </Card>

      {/* Topics */}
      <Card padding="md">
        <div class="space-y-3">
          <h3 class="text-sm font-semibold text-ink">Research Topics</h3>
          <p class="text-sm text-mute py-4 text-center">No topics configured. Add topics to start automated research.</p>
        </div>
      </Card>

      {/* Notifications */}
      <Card padding="md">
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <div>
              <h3 class="text-sm font-semibold text-ink">Notifications</h3>
              <p class="mt-0.5 text-xs text-body">Get notified when research runs complete.</p>
            </div>
            <Badge variant="default">Not configured</Badge>
          </div>
          <p class="text-xs text-mute">Enable notifications to receive alerts when automation tasks finish.</p>
        </div>
      </Card>
    </div>
  </div>
</DashboardLayout>
