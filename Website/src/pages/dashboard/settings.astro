---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Card from '../../components/Card.astro';
---

<DashboardLayout title="Settings — AI Idea Researcher">
  <div class="p-6 lg:p-8 max-w-6xl mx-auto space-y-8">
    {/* Header */}
    <div>
      <h1 class="text-2xl font-semibold text-ink">Settings</h1>
      <p class="mt-1 text-sm text-body">Manage your account and application preferences.</p>
    </div>

    {/* API Connection */}
    <Card padding="lg">
      <div class="space-y-4">
        <h2 class="text-base font-semibold text-ink">API Connection</h2>
        <div id="api-status" class="flex items-center gap-3">
          <div id="api-dot" class="h-3 w-3 rounded-full bg-mute animate-pulse"></div>
          <div>
            <p id="api-label" class="text-sm font-medium text-ink">Checking connection...</p>
            <p id="api-detail" class="text-xs text-body">Verifying backend availability</p>
          </div>
        </div>
        <div class="flex flex-col gap-1.5">
          <label class="text-sm font-medium text-ink">API URL</label>
          <input
            type="url"
            value={import.meta.env.PUBLIC_API_URL || 'http://localhost:8000'}
            disabled
            class="rounded-sm border border-hairline bg-hairline-soft px-3 py-2 text-sm font-mono text-mute cursor-not-allowed"
          />
        </div>
        <p class="text-xs text-mute">Set via PUBLIC_API_URL environment variable. Backend handles all API keys and database connections.</p>
      </div>
    </Card>

    {/* Profile */}
    <Card padding="lg">
      <div class="space-y-6">
        <h2 class="text-base font-semibold text-ink">Profile</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="flex flex-col gap-1.5">
            <label class="text-sm font-medium text-ink">Name</label>
            <input
              type="text"
              value="User"
              disabled
              class="rounded-sm border border-hairline bg-hairline-soft px-3 py-2 text-sm text-mute cursor-not-allowed"
            />
          </div>
          <div class="flex flex-col gap-1.5">
            <label class="text-sm font-medium text-ink">Email</label>
            <input
              type="email"
              value="user@example.com"
              disabled
              class="rounded-sm border border-hairline bg-hairline-soft px-3 py-2 text-sm text-mute cursor-not-allowed"
            />
          </div>
        </div>
        <p class="text-xs text-mute">Edit profile settings after connecting your backend.</p>
      </div>
    </Card>

    {/* Notification Preferences */}
    <Card padding="lg">
      <div class="space-y-4">
        <h2 class="text-base font-semibold text-ink">Notification Preferences</h2>
        <div class="space-y-3">
          {[
            { label: 'Research completed', desc: 'Notify when a research run finishes' },
            { label: 'Report generated', desc: 'Notify when a new report is ready' },
            { label: 'Agent errors', desc: 'Notify when an agent encounters an error' },
          ].map((item) => (
            <div class="flex items-center justify-between py-2">
              <div>
                <p class="text-sm font-medium text-ink">{item.label}</p>
                <p class="text-xs text-body">{item.desc}</p>
              </div>
              <div class="relative">
                <input type="checkbox" disabled class="sr-only peer" />
                <label class="flex h-6 w-11 cursor-not-allowed items-center rounded-full bg-hairline transition-colors">
                  <span class="inline-block h-4 w-4 translate-x-1 rounded-full bg-white shadow-sm"></span>
                </label>
              </div>
            </div>
          ))}
        </div>
        <p class="text-xs text-mute">Enable after connecting your backend.</p>
      </div>
    </Card>

    {/* Security */}
    <Card padding="lg">
      <div class="space-y-4">
        <h2 class="text-base font-semibold text-ink">Security</h2>
        <div class="rounded-md border border-hairline-soft bg-hairline-soft/50 p-4">
          <p class="text-sm text-body">
            Authentication and API key management will be available in a future release.
            The backend handles all sensitive credentials (OPENROUTER_API_KEY, DATABASE_URL, GITHUB_TOKEN)
            — these are never exposed to the frontend.
          </p>
        </div>
      </div>
    </Card>

    <script>
      const API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';

      async function checkApi() {
        const dot = document.getElementById('api-dot')!;
        const label = document.getElementById('api-label')!;
        const detail = document.getElementById('api-detail')!;

        try {
          const res = await fetch(`${API_BASE}/health`, { signal: AbortSignal.timeout(5000) });
          if (res.ok) {
            const data = await res.json();
            dot.className = 'h-3 w-3 rounded-full bg-green-500';
            label.textContent = 'Connected';
            label.className = 'text-sm font-medium text-green-800';
            detail.textContent = `Backend is online (status: ${data.status})`;
            detail.className = 'text-xs text-green-700';
            return;
          }
        } catch {}

        dot.className = 'h-3 w-3 rounded-full bg-red-500';
        label.textContent = 'Not Connected';
        label.className = 'text-sm font-medium text-error';
        detail.textContent = `Unable to reach ${API_BASE}`;
        detail.className = 'text-xs text-body';
      }

      checkApi();
    </script>
  </div>
</DashboardLayout>
