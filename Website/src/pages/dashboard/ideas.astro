---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EmptyState from '../../components/EmptyState.astro';
---

<DashboardLayout title="Ideas — AI Idea Researcher">
  <div class="p-6 lg:p-8 max-w-6xl mx-auto space-y-6">
    <Breadcrumbs items={[
      { label: 'Dashboard', href: '/dashboard' },
      { label: 'Ideas' },
    ]} />

    {/* Header */}
    <div>
      <h1 class="text-2xl font-semibold text-ink">Ideas</h1>
      <p class="mt-1 text-sm text-body">Browse discovered startup ideas and opportunities.</p>
    </div>

    {/* Status Banner */}
    <div class="rounded-md border border-blue-200 bg-link-soft px-4 py-3 text-sm text-blue-800" role="status">
      <span class="font-medium">Waiting for idea-generation backend.</span> Ideas will be generated from completed research runs when the multi-agent pipeline is connected.
    </div>

    {/* Search & Filters — visual structure, disabled */}
    <div class="space-y-3">
      <div class="relative">
        <svg class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="8" />
          <path d="M21 21l-4.35-4.35" />
        </svg>
        <input
          type="text"
          placeholder="Search ideas..."
          disabled
          class="w-full rounded-sm border border-hairline bg-hairline-soft py-2 pl-10 pr-4 text-sm text-mute cursor-not-allowed"
          aria-label="Search ideas (not yet available)"
        />
      </div>
      <div class="flex flex-wrap gap-2">
        {['All', 'Developer Tools', 'E-commerce', 'SaaS', 'AI/ML'].map((filter) => (
          <span class="inline-flex items-center rounded-full border border-hairline bg-hairline-soft px-3 py-1 text-xs font-medium text-mute cursor-not-allowed">
            {filter}
          </span>
        ))}
      </div>
    </div>

    {/* Empty State */}
    <EmptyState
      icon='<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>'
      title="No ideas yet"
      description="Idea generation will appear here once the AI multi-agent pipeline is connected. Run a research session to start the process."
      actionLabel="Start Research"
      actionHref="/dashboard/research"
    />

    {/* Future features preview */}
    <div class="grid gap-4 md:grid-cols-3">
      <div class="rounded-md border border-dashed border-hairline bg-canvas-elevated p-6 text-center">
        <p class="text-sm font-medium text-mute">Idea list</p>
        <p class="mt-1 text-xs text-faint">Title, problem, solution, status</p>
      </div>
      <div class="rounded-md border border-dashed border-hairline bg-canvas-elevated p-6 text-center">
        <p class="text-sm font-medium text-mute">Idea categories</p>
        <p class="mt-1 text-xs text-faint">Filter by category, status, complexity</p>
      </div>
      <div class="rounded-md border border-dashed border-hairline bg-canvas-elevated p-6 text-center">
        <p class="text-sm font-medium text-mute">Idea detail</p>
        <p class="mt-1 text-xs text-faint">Problem, solution, MVP, monetization</p>
      </div>
    </div>
  </div>
</DashboardLayout>
