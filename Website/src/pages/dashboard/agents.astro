---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Card from '../../components/Card.astro';
import { DEMO_AGENTS } from '../../lib/api/demo';

function formatTokens(n?: number) {
  if (!n) return '—';
  return n.toLocaleString();
}

function formatTime(iso?: string) {
  if (!iso) return 'Never';
  return new Date(iso).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
}

const statusConfig: Record<string, { dot: string; label: string }> = {
  idle: { dot: 'bg-mute', label: 'Idle' },
  running: { dot: 'bg-link', label: 'Running' },
  error: { dot: 'bg-error', label: 'Error' },
};
---

<DashboardLayout title="AI Agents — AI Idea Researcher">
  <div class="p-6 lg:p-8 max-w-6xl mx-auto space-y-6">
    {/* Header */}
    <div>
      <h1 class="text-2xl font-semibold text-ink">AI Agents</h1>
      <p class="mt-1 text-sm text-body">Monitor and manage your AI research agents.</p>
    </div>

    {/* Demo Banner */}
    <div class="rounded-md border border-amber-200 bg-warning-soft px-4 py-3 text-sm text-amber-800">
      <span class="font-medium">Backend not connected</span> — showing demo data.
    </div>

    {/* Agent Grid */}
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {DEMO_AGENTS.map((agent) => {
        const s = statusConfig[agent.status];
        return (
          <Card padding="md">
            <div class="space-y-3">
              <div class="flex items-start justify-between">
                <div>
                  <h3 class="text-sm font-semibold text-ink">{agent.name}</h3>
                  <p class="mt-0.5 text-xs text-mute capitalize">{agent.type}</p>
                </div>
                <div class="flex items-center gap-2">
                  <div class:list={['h-2 w-2 rounded-full', s.dot]}></div>
                  <span class="text-xs font-medium text-body">{s.label}</span>
                </div>
              </div>
              <div class="grid grid-cols-2 gap-x-4 gap-y-2 border-t border-hairline-soft pt-3">
                <div>
                  <p class="text-xs text-mute">Model</p>
                  <p class="text-sm font-medium text-ink">{agent.model ?? '—'}</p>
                </div>
                <div>
                  <p class="text-xs text-mute">Tokens Used</p>
                  <p class="text-sm font-medium text-ink">{formatTokens(agent.tokens_used)}</p>
                </div>
                <div class="col-span-2">
                  <p class="text-xs text-mute">Last Run</p>
                  <p class="text-sm text-body">{formatTime(agent.last_run)}</p>
                </div>
              </div>
            </div>
          </Card>
        );
      })}
    </div>
  </div>
</DashboardLayout>
