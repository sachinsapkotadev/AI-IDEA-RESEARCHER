---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Card from '../../components/Card.astro';
import StatusBadge from '../../components/StatusBadge.astro';
---

<DashboardLayout title="AI Agents — AI Idea Researcher">
  <div class="p-6 lg:p-8 max-w-6xl mx-auto space-y-6">
    <Breadcrumbs items={[
      { label: 'Dashboard', href: '/dashboard' },
      { label: 'Agents' },
    ]} />

    {/* Header */}
    <div>
      <h1 class="text-2xl font-semibold text-ink">AI Agents</h1>
      <p class="mt-1 text-sm text-body">Monitor and manage your AI research agents.</p>
    </div>

    {/* Status Banner */}
    <div class="rounded-md border border-blue-200 bg-link-soft px-4 py-3 text-sm text-blue-800" role="status">
      <span class="font-medium">Agent monitoring will be available after the multi-agent backend is implemented.</span> The backend currently handles research without individual agent tracking.
    </div>

    {/* Agent Grid — planned agents */}
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {[
        { name: 'Research Agent', type: 'Researcher', desc: 'Searches the web for relevant information on a given topic' },
        { name: 'Market Analyst', type: 'Analyst', desc: 'Analyzes market size, trends, and competition dynamics' },
        { name: 'Competitor Analyst', type: 'Analyst', desc: 'Deep-dives into existing solutions and their positioning' },
        { name: 'Idea Generator', type: 'Generator', desc: 'Synthesizes research findings into actionable startup ideas' },
        { name: 'Technical Analyst', type: 'Analyst', desc: 'Evaluates technical feasibility and implementation complexity' },
        { name: 'Report Writer', type: 'Writer', desc: 'Generates structured research reports from collected data' },
      ].map((agent) => (
        <Card padding="md">
          <div class="space-y-3">
            <div class="flex items-start justify-between">
              <div>
                <h3 class="text-sm font-semibold text-ink">{agent.name}</h3>
                <p class="mt-0.5 text-xs text-mute">{agent.type}</p>
              </div>
              <StatusBadge status="coming-soon" label="Planned" />
            </div>
            <p class="text-xs text-body">{agent.desc}</p>
            <div class="grid grid-cols-2 gap-x-4 gap-y-2 border-t border-hairline-soft pt-3">
              <div>
                <p class="text-xs text-mute">Model</p>
                <p class="text-sm font-medium text-mute">—</p>
              </div>
              <div>
                <p class="text-xs text-mute">Status</p>
                <p class="text-sm font-medium text-mute">Not active</p>
              </div>
              <div>
                <p class="text-xs text-mute">Last Run</p>
                <p class="text-sm text-mute">Never</p>
              </div>
              <div>
                <p class="text-xs text-mute">Tokens Used</p>
                <p class="text-sm text-mute">—</p>
              </div>
            </div>
          </div>
        </Card>
      ))}
    </div>
  </div>
</DashboardLayout>
