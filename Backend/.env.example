# Application
APP_NAME=AI Idea Researcher API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_idea_researcher

# OpenRouter Free Models - API Keys (round-robin rotation)
# Get free keys at https://openrouter.ai/keys
# Add up to 50 keys (OPENROUTER_API_KEY_01 through OPENROUTER_API_KEY_50)
OPENROUTER_API_KEY_01=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY_02=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY_03=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY_04=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY_05=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY_06=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY_07=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY_08=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY_09=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY_10=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY_11=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY_12=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# Proxy settings (for OpenCode to connect through)
OPENROUTER_PROXY_PORT=3457
OPENROUTER_PROXY_HOST=127.0.0.1
OPENROUTER_MAX_RETRIES=3

# Search Provider (Phase 4)
# Options: google
SEARCH_PROVIDER=google
SEARCH_API_KEY=
SEARCH_ENGINE_ID=
SEARCH_DEFAULT_NUM=10

# Source Limits (Phase 4)
MAX_SEARCH_RESULTS=10
MAX_SOURCES_PER_RESEARCH=10
MAX_CONTENT_LENGTH_PER_SOURCE=50000
MAX_TOTAL_RESEARCH_CONTEXT=100000
MAX_CONCURRENT_RESEARCH=5

# Content Extraction (Phase 4)
SEARCH_USER_AGENT=AI-Idea-Researcher/1.0 (+https://ai-idea-researcher.local)

# GitHub (Phase 5+)
# GITHUB_TOKEN=your-github-token-here
# GITHUB_REPOSITORY=owner/repo-name
