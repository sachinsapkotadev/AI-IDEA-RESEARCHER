# Application
APP_NAME=AI Idea Researcher API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_idea_researcher

# OpenRouter (Phase 3+)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# Search Provider (Phase 4)
# Options: google
SEARCH_PROVIDER=google
SEARCH_API_KEY=
SEARCH_ENGINE_ID=
SEARCH_DEFAULT_NUM=10

# Source Limits (Phase 4)
MAX_SEARCH_RESULTS=10
MAX_SOURCES_PER_RESEARCH=10
MAX_CONTENT_LENGTH_PER_SOURCE=50000
MAX_TOTAL_RESEARCH_CONTEXT=100000
MAX_CONCURRENT_RESEARCH=5

# Content Extraction (Phase 4)
SEARCH_USER_AGENT=AI-Idea-Researcher/1.0 (+https://ai-idea-researcher.local)

# GitHub (Phase 5+)
# GITHUB_TOKEN=your-github-token-here
# GITHUB_REPOSITORY=owner/repo-name
