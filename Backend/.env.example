# Application
APP_NAME=AI Idea Researcher API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_idea_researcher

# OpenRouter (Phase 3+)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# GitHub (Phase 3+)
# GITHUB_TOKEN=your-github-token-here
# GITHUB_REPOSITORY=owner/repo-name
