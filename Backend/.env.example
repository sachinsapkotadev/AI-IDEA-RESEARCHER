# Application
APP_NAME=AI Idea Researcher API
APP_VERSION=0.2.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_idea_researcher

# ─── OpenRouter API Keys (11 slots: _00 through _10) ─────────────────
# Get free keys at https://openrouter.ai/keys
# Unused slots can be left empty.
OPENROUTER_API_KEY_00=
OPENROUTER_API_KEY_01=
OPENROUTER_API_KEY_02=
OPENROUTER_API_KEY_03=
OPENROUTER_API_KEY_04=
OPENROUTER_API_KEY_05=
OPENROUTER_API_KEY_06=
OPENROUTER_API_KEY_07=
OPENROUTER_API_KEY_08=
OPENROUTER_API_KEY_09=
OPENROUTER_API_KEY_10=

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_RETRIES=3

# ─── Model Configuration ─────────────────────────────────────────────
# Default model (required for AI execution)
OPENROUTER_MODEL=

# Agent-specific model overrides (optional, falls back to OPENROUTER_MODEL)
OPENROUTER_RESEARCH_MODEL=
OPENROUTER_MARKET_MODEL=
OPENROUTER_COMPETITOR_MODEL=
OPENROUTER_IDEA_MODEL=
OPENROUTER_TECHNICAL_MODEL=
OPENROUTER_VALIDATION_MODEL=
OPENROUTER_REPORT_MODEL=

# ─── Search Provider (Phase 4) ───────────────────────────────────────
SEARCH_PROVIDER=google
SEARCH_API_KEY=
SEARCH_ENGINE_ID=
SEARCH_DEFAULT_NUM=10

# Source Limits (Phase 4)
MAX_SEARCH_RESULTS=10
MAX_SOURCES_PER_RESEARCH=10
MAX_CONTENT_LENGTH_PER_SOURCE=50000
MAX_TOTAL_RESEARCH_CONTEXT=100000
MAX_CONCURRENT_RESEARCH=5

# Content Extraction (Phase 4)
SEARCH_USER_AGENT=AI-Idea-Researcher/1.0 (+https://ai-idea-researcher.local)

# ─── Report Generation (Phase 6) ─────────────────────────────────────
REPORTS_DIR=./reports

# ─── GitHub Integration (Phase 6) ────────────────────────────────────
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_DEFAULT_BRANCH=main
GITHUB_RESEARCH_BRANCH_PREFIX=research/
